# ---------------------------------------------------------------------------
# Copy this file to  .env  and fill in what you need.
# Everything has a working default except SERPAPI_KEY.
# ---------------------------------------------------------------------------

# --- Search ----------------------------------------------------------------
# Free key (100 searches/month): https://serpapi.com/manage-api-key
# Without it the pipeline falls back to key-free scraped engines, which are
# best-effort and much less reliable.
SERPAPI_KEY="25ad8a10b1d784d2abb880af52ebd2c932ccee2c3ab29ed731819ed2b52667f4"

# --- Blockchain ------------------------------------------------------------
# memory  : in-process EVM (eth-tester). Zero setup, resets each run.
# local   : JSON-RPC node on this machine (Hardhat / Anvil / Ganache).
# testnet : public testnet, real explorer links.
CHAIN_MODE=memory

# used when CHAIN_MODE=local
RPC_URL=http://127.0.0.1:8545

# used when CHAIN_MODE=testnet  (default below is Polygon Amoy)
TESTNET_RPC_URL=https://rpc-amoy.polygon.technology
EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/

# Funded test wallet. NEVER put a real-money key here.
# Required for testnet; optional for local (Hardhat/Anvil unlock accounts for you).
PRIVATE_KEY=

# --- Matching --------------------------------------------------------------
# SFace's published cosine operating point is 0.363.
MATCH_THRESHOLD=0.363
# Stricter bar before a *web* hit is accepted as the same person.
WEB_MATCH_THRESHOLD=0.40
DETECT_SCORE_THRESHOLD=0.7
SEARCH_MAX_CANDIDATES=25

# --- Web app ---------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
